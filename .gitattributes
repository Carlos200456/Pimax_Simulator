# LF en el repositorio, CRLF en el working tree de Windows.
# Evita que diffs y merges marquen archivos enteros como modificados.
* text=auto

# --- Texto (checkout con CRLF) ---
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.resx      text eol=crlf
*.xaml      text eol=crlf
*.config    text eol=crlf
*.settings  text eol=crlf
*.xml       text eol=crlf
*.json      text eol=crlf
*.txt       text eol=crlf
*.csv       text eol=crlf
*.md        text eol=crlf
*.ptp       text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf

# --- Binarios (git no los toca) ---
*.png       binary
*.jpg       binary
*.bmp       binary
*.ico       binary
*.wav       binary
*.resources binary
*.dll       binary
*.exe       binary
*.pdb       binary
